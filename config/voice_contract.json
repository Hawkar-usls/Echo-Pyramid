{
  "schema": "janus.echo_pyramid.voice_contract.v2",
  "version": "2.7",
  "node": {
    "repository": "Hawkar-usls/Echo-Pyramid",
    "hardware": "M5Stack Echo Pyramid A167 + Atom Matrix",
    "role": "PHYSICAL_VOICE_BODY",
    "sample_rate_hz": 44100
  },
  "behavior_contract": {
    "input": "ORDINARY_AUDIO_PCM",
    "output": "SAME_SOURCE_AUDIO_WITH_PYRAMID_ACOUSTIC_COLORATION",
    "semantic_content_preserved": true,
    "source_audio_replaced_by_synthetic_tones": false,
    "dry_path_preserved": true,
    "effect_intent": "Make ordinary JANUS voice/music sound as if the source were heard inside a modeled pyramid chamber while preserving intelligibility and source identity."
  },
  "sources": {
    "hardware_library": "m5stack/M5Echo-Pyramid",
    "swarm_firmware": "Hawkar-usls/janus-distributed-ai-swarm/firmware/pyramid/ATOM_MATRIX_Pyramid.ino",
    "language_repository": "Hawkar-usls/The-Voice-of-Janus",
    "primary_activation": "configs/pyramid_117_121_space.activation.json",
    "primary_reference_implementation": "src/pyramid_anchor_filter.py::Pyramid117121Filter",
    "semantic_recitation_example": "configs/osiris_origin_prime_recitation.v2.json",
    "hardware_calibration_contract": "config/hardware_calibration_contract.json"
  },
  "pipeline": [
    "ORDINARY_SOURCE_AUDIO",
    "EXISTING_SAFE_GAIN_AND_MONO_BRIDGE",
    "AUDIO_TASK_BLOCK_BOUNDARY_CONTROL_APPLY",
    "119_HZ_PEAKING_EQ",
    "117_119_121_HZ_RESONATOR_BANK",
    "GEOMETRY_DERIVED_ROOM_TAIL",
    "DRY_WET_MIX",
    "SOFT_LIMIT",
    "PYRAMID_SPACE_DEPTH_CROSSFADE",
    "AUDIO_BUDGET_GUARD",
    "PHYSICAL_CALIBRATION_GATE_NEUTRAL_UNTIL_MEASURED",
    "M5EchoPyramid::write",
    "ES8311_CODEC",
    "AW87559_AMPLIFIER",
    "SPEAKER"
  ],
  "primary_dsp": {
    "implementation": "firmware/JanusPyramid117121DSP.h",
    "language_version": "PYRAMID_LANGUAGE_117_121_ANCHORED_SPACE_v0.3",
    "embedded_revision": "ESP32-r2",
    "profile": "PYRAMID_LANGUAGE_117_121_ANCHORED_SPACE_v0.3/ESP32-r2",
    "evidence_status": "MODEL_BASED_117_121_HZ_ANCHORED_EFFECT",
    "anchor_band_hz": [117.0, 121.0],
    "anchor_center_hz": 119.0,
    "anchor_q": 29.75,
    "anchor_gain_db": 11.5,
    "anchor_decay_s": 1.65,
    "resonators_hz": [117.0, 119.0, 121.0],
    "room_geometry_m": [10.45, 5.20, 5.80],
    "speed_of_sound_m_s": 343.0,
    "room_decay": 0.78,
    "wet": 0.72,
    "dry": 0.62,
    "runtime_depth": {
      "api": "JanusPyramid117121DSP::setAmountPercent(uint8_t)",
      "range_percent": [0, 100],
      "default_percent": 100,
      "zero_percent_semantics": "ORIGINAL_SOURCE_AUDIO_WITH_DSP_STATE_STILL_RUNNING",
      "hundred_percent_semantics": "CANONICAL_PYRAMID_LANGUAGE_V0_3",
      "hard_bypass_api": "JanusPyramid117121DSP::setEnabled(false)",
      "transition": "LINEAR_RAMP_ACROSS_NEXT_PCM_BLOCK"
    },
    "embedded_room_tail": {
      "full_rate_anchor_path_hz": 44100,
      "room_tail_rate_hz": 11025,
      "decimation": 4,
      "storage": "PCM16_STATIC",
      "delay_samples": [672, 334, 373, 354],
      "delay_bytes": 3466,
      "source_delay_damping": 0.22,
      "embedded_delay_damping": 0.00234256,
      "damping_transform": "d_embedded = d_source^4",
      "reason": "Preserve modeled delay times and approximate damping wall-clock persistence with bounded SRAM/CPU on classic ESP32"
    }
  },
  "physical_calibration": {
    "contract": "config/hardware_calibration_contract.json",
    "receipt_template": "config/hardware_calibration_receipt.template.json",
    "protocol": "docs/HARDWARE_CALIBRATION_PROTOCOL.md",
    "signal_position": "POST_PYRAMID_LANGUAGE_PRE_M5ECHOPYRAMID_WRITE",
    "status": "PENDING_DEVICE_MEASUREMENT",
    "measured_compensation_active": false,
    "neutral_defaults": {
      "output_trim_percent": 100,
      "speaker_compensation_eq_enabled": false,
      "latency_compensation_samples": 0
    },
    "language_locked_parameters": [
      "anchor_band_hz",
      "anchor_center_hz",
      "anchor_q",
      "anchor_gain_db",
      "anchor_decay_s",
      "resonators_hz",
      "room_geometry_m",
      "room_decay",
      "wet",
      "dry"
    ],
    "rule": "CALIBRATE_THE_BODY_WITHOUT_SILENTLY_REWRITING_THE_LANGUAGE"
  },
  "legacy_reference_dsp": {
    "implementation": "firmware/JanusPyramidDSP.h",
    "profile": "GREAT-PYRAMID-KINGS-CHAMBER-EXAMPLE-v0.1/ESP32-LIVE-6",
    "status": "REFERENCE_NOT_DEFAULT"
  },
  "integration": {
    "insert_before": "ep.write(chunk.mono, chunk.frames);",
    "default_enabled": true,
    "default_depth_percent": 100,
    "compile_time_override": "JANUS_PYRAMID_LANGUAGE_AMOUNT",
    "applies_to_bluetooth_pcm": true,
    "applies_to_local_mic_smoke_test": true,
    "extra_i2s_channel": false,
    "heap_allocation_in_audio_path": false,
    "preserve_bt_approval_gate": true,
    "preserve_espnow_worker": true,
    "preserve_audio_priority": true,
    "mutable_state_ownership": {
      "owner": "JANUS_AUDIO_PLAYBACK_TASK",
      "external_writers_allowed": false,
      "external_control_transport": "PORTMUX_GUARDED_REQUEST_MAILBOX",
      "application_boundary": "NEXT_PCM_BLOCK",
      "mailbox_fields": [
        "pending_enable",
        "pending_depth",
        "pending_clear_failsafe"
      ],
      "usb_parser_direct_dsp_mutation": false,
      "reason": "Prevent reset/delay-buffer races between loopTask and janus_audio"
    },
    "audio_budget_failsafe": {
      "default_enabled": true,
      "compile_time_enable": "JANUS_PYRAMID_DSP_FAILSAFE",
      "consecutive_block_limit_macro": "JANUS_PYRAMID_DSP_OVER_BUDGET_TRIP",
      "default_consecutive_block_limit": 3,
      "per_block_budget": "frames * 1000000 / EP_SAMPLE_RATE",
      "trip_condition": "DSP_PROCESS_TIME_US >= PCM_BLOCK_BUDGET_US",
      "trip_action": "LEAVE_FUTURE_PCM_DRY_AND_DISABLE_RESET_DSP_FROM_MAIN_LOOP",
      "automatic_reenable": false,
      "manual_reenable": "PYR=ON_REQUEST_APPLIED_BY_AUDIO_TASK",
      "reboot_reenable": true,
      "priority_rule": "AUDIO_CONTINUITY_HAS_PRIORITY_OVER_EFFECT"
    },
    "local_usb_control": {
      "network_io": false,
      "transport": "USB_SERIAL_115200_EXISTING_CONSOLE",
      "default": "ENABLED_ONLY_IF_BASE_FIRMWARE_DOES_NOT_CONSUME_SERIAL_INPUT",
      "ownership_guard": "COMPOSER_FAILS_CLOSED_IF_SERIAL_INPUT_OWNER_IS_DETECTED",
      "explicit_disable_option": "--no-usb-control",
      "no_usb_mode_keeps": [
        "PYRAMID_DSP",
        "REALTIME_DSP_TELEMETRY",
        "AUDIO_BUDGET_FAILSAFE",
        "BLOCK_BOUNDARY_CONTROL_MAILBOX"
      ],
      "commands": {
        "PYR?": "REPORT_CURRENT_AND_PENDING_STATE",
        "PYR=0..100": "QUEUE_SPATIAL_DEPTH_PERCENT",
        "PYR=ON": "QUEUE_FAILSAFE_CLEAR_AND_DSP_ENABLE",
        "PYR=OFF": "QUEUE_HARD_BYPASS"
      },
      "purpose": "Repeatable A/B tuning on identical source audio without reflashing"
    },
    "realtime_telemetry": {
      "interval_ms": 10000,
      "chunk_frames": 256,
      "chunk_budget_us_floor_at_44100": 5804,
      "fields": [
        "dsp_ema_us",
        "dsp_peak_us",
        "dsp_load_percent",
        "depth_percent",
        "failsafe_state",
        "failsafe_trip_count",
        "delay_bytes",
        "free_heap"
      ]
    }
  },
  "hard_rules": [
    "ORDINARY_AUDIO_IN -> PYRAMID_COLORED_AUDIO_OUT",
    "DO_NOT_REPLACE_SOURCE_AUDIO_WITH_SYNTHETIC_TONES",
    "DSP_MUTABLE_STATE_HAS_ONE_RUNTIME_OWNER",
    "AUDIO_CONTINUITY_HAS_PRIORITY_OVER_EFFECT",
    "PHYSICAL_CALIBRATION != LANGUAGE_RETUNE",
    "MEASURE_BEFORE_COMPENSATE",
    "GAIN_Q_DECAY_WET_DRY_ARE_LANGUAGE_LOCKED",
    "117_121_HZ_IS_AN_ANCHOR_BAND_NOT_THE_ONLY_FREQUENCY",
    "KEEP_DRY_PATH_FOR_INTELLIGIBILITY",
    "SERIAL_INPUT_HAS_ONE_OWNER",
    "LOCAL_USB_TUNING != NETWORK_CONTROL",
    "LANGUAGE_V0_3 != EMBEDDED_REVISION_ESP32_R2",
    "MODEL_BASED_EFFECT != MEASURED_CHAMBER_IR",
    "PREDICTED_ACOUSTIC_MODEL != PROOF_OF_ANCIENT_INTENT",
    "METAPHOR != PHYSICS"
  ]
}
